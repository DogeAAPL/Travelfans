# Copia este archivo como .env y completa los valores. El .env NO se sube a git.

# Usuario del panel de administración
VITE_ADMIN_USER=admin

# Hash de la contraseña del panel. Genéralo con:
#   npm run hash-password -- "tu-contraseña-segura"
# Si se deja vacío se usa la contraseña de ejemplo (travelfans2024) y el panel muestra un aviso.
VITE_ADMIN_PASSWORD_HASH=

# ID de Google Analytics 4 (G-XXXXXXX). Si se deja vacío no se carga Analytics ni el aviso de cookies.
VITE_GA_ID=
