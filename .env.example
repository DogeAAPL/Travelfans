# Copia este archivo como .env y completa los valores. El .env NO se sube a git.

# --- Supabase (backend) ---
# Dashboard de Supabase > Project Settings > API. Usa la clave "publishable" (sb_publishable_...),
# nunca la "secret" / service_role. Si se dejan vacías, el sitio funciona en modo local.
VITE_SUPABASE_URL=https://dkwjjarbexehcvmwoxko.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Modo local (solo si NO hay Supabase) ---
# Usuario y hash de contraseña del panel. Genera el hash con:
#   npm run hash-password -- "tu-contraseña-segura"
# Si el hash se deja vacío se usa la contraseña de ejemplo (travelfans2024) y el panel muestra un aviso.
VITE_ADMIN_USER=admin
VITE_ADMIN_PASSWORD_HASH=

# --- Analítica ---
# ID de Google Analytics 4 (G-XXXXXXX). Si se deja vacío no se carga Analytics ni el aviso de cookies.
VITE_GA_ID=
